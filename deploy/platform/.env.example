# Local-only defaults are embedded in compose.yaml so the platform starts with
# no additional setup. Override every secret before binding beyond loopback.
PLATFORM_BIND_HOST=127.0.0.1
SNAPLINK_ADMIN_PASSWORD=change-this-admin-password
AUDIT_POSTGRES_PASSWORD=change-this-audit-database-password
AERO_VAULT_POSTGRES_PASSWORD=change-this-vault-database-password
AERO_VAULT_MINIO_USER=aerovault
AERO_VAULT_MINIO_PASSWORD=change-this-minio-password
AERO_VAULT_AUDIT_HMAC_KEY=replace-with-a-random-32-byte-key
AERO_ID_POSTGRES_PASSWORD=change-this-id-database-password
AERO_IM_POSTGRES_PASSWORD=change-this-im-database-password
AUDIT_SIGNING_SECRET=replace-with-a-random-32-byte-signing-secret
AUDIT_ENCRYPTION_KEY=replace-with-a-random-32-byte-encryption-key
