# Local-only defaults are embedded in compose.yaml so the platform starts with
# no additional setup. Override every secret before binding beyond loopback.
PLATFORM_BIND_HOST=127.0.0.1
SNAPLINK_ADMIN_PASSWORD=change-this-admin-password
# Snaplink's supported SSO_CLIENTS env override keeps OAuth secrets out of
# config/snaplink.yaml. Use one distinct value per confidential client.
SNAPLINK_CLIENT_SECRET_SSO_ADMIN_CONSOLE=replace-with-a-random-snaplink-admin-client-secret
SNAPLINK_CLIENT_SECRET_AERO_IM=replace-with-a-random-aero-im-client-secret
SNAPLINK_CLIENT_SECRET_AERO_IM_VAULT=replace-with-a-random-aero-im-vault-client-secret
SNAPLINK_CLIENT_SECRET_AERO_VAULT_AUDIT=replace-with-a-random-aero-vault-audit-client-secret
SNAPLINK_CLIENT_SECRET_AERO_IM_AUDIT=replace-with-a-random-aero-im-audit-client-secret
SNAPLINK_CLIENT_SECRET_PLATFORM_AUDIT_BOOTSTRAP=replace-with-a-random-platform-audit-bootstrap-secret
AUDIT_POSTGRES_PASSWORD=change-this-audit-database-password
AERO_VAULT_POSTGRES_PASSWORD=change-this-vault-database-password
AERO_VAULT_MINIO_USER=aerovault
AERO_VAULT_MINIO_PASSWORD=change-this-minio-password
AERO_VAULT_AUDIT_HMAC_KEY=replace-with-a-random-32-byte-key
AERO_ID_POSTGRES_PASSWORD=change-this-id-database-password
AERO_ID_SIGNING_KEY=replace-with-a-random-signing-key
AERO_ID_CALLBACK_MASTER_KEY=replace-with-a-random-callback-master-key
AERO_ID_EVENT_INGEST_SIGNING_KEY=replace-with-a-random-event-ingest-signing-key
AERO_ID_AUDIT_LEDGER_SIGNING_KEY=replace-with-a-random-audit-ledger-signing-key
AERO_ID_EXPORT_ENCRYPTION_KEY=replace-with-a-random-export-encryption-key
AERO_ID_AUDIT_CLIENT_SECRET_PLATFORM_LOCAL=replace-with-a-random-audit-client-secret
AERO_ID_SOURCES_SNAPLINK_OAUTH_CLIENT_SECRET=replace-with-a-random-snaplink-source-secret
AERO_ID_SOURCES_AERO_IM_OAUTH_CLIENT_SECRET=replace-with-a-random-aero-im-source-secret
AERO_ID_SOURCES_AERO_VAULT_OAUTH_CLIENT_SECRET=replace-with-a-random-aero-vault-source-secret
AERO_IM_POSTGRES_PASSWORD=change-this-im-database-password
AUDIT_SIGNING_SECRET=replace-with-a-random-32-byte-signing-secret
AUDIT_ENCRYPTION_KEY=replace-with-a-random-32-byte-encryption-key
