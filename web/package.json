{
  "name": "aero-im-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Aero IM SolidJS frontend built with Iris UI.",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "build:iris": "pnpm --dir ../../iris-ui --filter @iris-ui-kit/solid... build",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && pnpm lint:legacy",
    "test:legacy": "node --test sso_entry.test.js solid_runtime.test.js api.test.js canvas.test.js canvas_create_intents.test.js solid_api.test.js compliance_admin.test.js delivery.test.js delivery_restore.test.js delivery_cursor.test.js drafts.test.js drafts_restore.test.js ws.test.js ws_delivery_barrier.test.js security_admin.test.js governance_utils.test.js rtc_config.test.js sfu_calls.test.js realtime_events.test.js render_giphy.test.js render_recall.test.js recall_errors.test.js solid_entry.test.js snaplink_sdk.test.js",
    "test": "pnpm test:legacy && pnpm test:solid",
    "test:solid": "vitest run --config vite.config.ts --environment jsdom test-solid/",
    "lint:legacy": "eslint --config eslint.config.js --ignore-pattern 'vendor/**' --ignore-pattern 'dist/**' .",
    "build:snaplink-sdk": "esbuild vendor/snaplink_sso_client.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=vendor/snaplink_sso_client.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@iris-ui-kit/core": "link:../../iris-ui/packages/core",
    "@iris-ui-kit/icons": "link:../../iris-ui/packages/icons",
    "@iris-ui-kit/skins": "link:../../iris-ui/packages/skins",
    "@iris-ui-kit/solid": "link:../../iris-ui/packages/solid",
    "@iris-ui-kit/theme": "link:../../iris-ui/packages/theme",
    "@iris-ui-kit/tokens": "link:../../iris-ui/packages/tokens",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^20.16.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.29.0",
    "globals": "^15.0.0",
    "jsdom": "25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "3.2.6"
  }
}
