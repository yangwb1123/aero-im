# Aero IM — example environment variables.
# Copy to `.env` for local development. Values mirror docker-compose.yml defaults.
# AERO__* config values use Figment's section mapping; single-underscore
# runtime flags below are read directly by their owning module.

# Docker Compose publishes Postgres, Redis, NATS, Jaeger, and MinIO only on
# loopback by default. Set a different bind address only behind an explicit
# host firewall and authenticated private network.
AERO_DEPENDENCY_BIND_HOST=127.0.0.1

# ---- Server ----
AERO__SERVER__HOST=0.0.0.0
AERO__SERVER__PORT=8080
AERO__SERVER__WEB_DIR=./web
# Public HTTP origin used by WHIP/HLS links and as the host fallback for
# wildcard RTMP/SRT listeners. It must be client-reachable.
AERO_PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---- Database (Postgres + pgvector) ----
AERO__DATABASE__URL=postgres://aero:aero_dev_pw@localhost:5432/aero
AERO__DATABASE__MAX_CONNECTIONS=16
# Optional; see config.example.toml for the consistency boundary.
# AERO__DATABASE__REPLICA_URL=postgres://aero:replace-me@replica.internal:5432/aero
# sqlx-cli also reads this:
DATABASE_URL=postgres://aero:aero_dev_pw@localhost:5432/aero

# ---- Redis ----
AERO__REDIS__URL=redis://localhost:6379

# ---- NATS JetStream ----
AERO__NATS__URL=nats://localhost:4222

# ---- Auth (JWT RS256) ----
# Generate keys: ./scripts/gen-jwt-keys.sh
# Prefer file-path indirection in production; for local dev, paste the PEM here
# or rely on config.toml. Multi-line env values must be quoted with literal \n.
AERO__AUTH__JWT_PRIVATE_KEY_PEM=
AERO__AUTH__JWT_PUBLIC_KEY_PEM=
AERO__AUTH__ISSUER=aero-im
AERO__AUTH__ACCESS_TTL_SECS=3600
AERO__AUTH__REFRESH_TTL_SECS=604800

# ---- External OIDC SSO (optional; all values fail closed when incomplete) ----
# ID-token verification. Snaplink publishes an Ed25519/EdDSA key through JWKS;
# Aero also accepts the existing RSA/RS256 provider shape.
# AERO__OIDC__ISSUER=https://sso.example.com
# AERO__OIDC__AUDIENCE=aero-im
# AERO__OIDC__JWKS_URI=https://sso.example.com/.well-known/jwks.json
# Confidential-client browser flow. The authorization endpoint must be the
# provider's hosted browser UI, and the HTTPS callback must be registered
# exactly as shown. Aero adds state, nonce, and PKCE S256 automatically.
# AERO__OIDC__AUTHORIZATION_ENDPOINT=https://sso.example.com/login/
# AERO__OIDC__TOKEN_ENDPOINT=https://sso.example.com/token
# AERO__OIDC__CLIENT_ID=aero-im
# AERO__OIDC__CLIENT_SECRET=
# AERO__OIDC__REDIRECT_URI=https://im.example.com/callback
# Login surface for the bundled SPA: local (Aero-owned form backed by the
# Snaplink SDK), snaplink (Snaplink hosted page), or both (default).
# AERO__OIDC__LOGIN_PAGE=both
# When Snaplink drives both OIDC and SCIM, set this to the same normalized
# issuer. SCIM externalId is then required and treated as Snaplink's stable sub,
# so pre-provisioning and first browser login resolve one participant.
# AERO__SCIM__IDENTITY_ISSUER=https://sso.example.com

# ---- Snaplink-authenticated project integrations (optional) ----
# External ERP/workers use client_credentials access tokens, never a human
# Aero session. The issuer/JWKS may reuse OIDC; the API audience is explicit.
# Tokens must carry typ=at+jwt, sub=client_id, iat/jti and
# scope `aero.notify.publish`.
# AERO__INTEGRATIONS__ISSUER=https://sso.example.com
# AERO__INTEGRATIONS__AUDIENCE=aero-im-integrations
# AERO__INTEGRATIONS__JWKS_URI=https://sso.example.com/.well-known/jwks.json
# Bounds complete multipart bodies (including sniffing, AV, Vault write and
# commit) held by each Aero IM process. Values are clamped to 1..=32.
# AERO__INTEGRATIONS__UPLOAD_MAX_CONCURRENCY=4
# AERO__SERVER__INTEGRATION_RECEIPT_SWEEP_SECS=60  # 0 disables bounded receipt cleanup

# ---- Snaplink commercial entitlement / metering / governance (optional) ----
# Two destination-specific client_credentials identities per workspace. Billing
# and Audit client IDs and secret values must be globally distinct. The strict
# JSON file references secret env names; it never contains client secrets.
# AERO_SNAPLINK_COMMERCIAL_ENABLED=true
# AERO_SNAPLINK_TOKEN_ENDPOINT=https://sso.example.com/token
# AERO_SNAPLINK_BILLING_BASE_URL=https://billing.example.com
# AERO_SNAPLINK_AUDIT_BASE_URL=https://audit.example.com
# AERO_SNAPLINK_BINDINGS_FILE=/run/aero/snaplink-commercial-bindings.json
# AERO_SNAPLINK_ACME_BILLING_CLIENT_SECRET=
# AERO_SNAPLINK_ACME_AUDIT_CLIENT_SECRET=
# Independent HMAC key for opaque tenant/workspace/delivery log references.
# AERO_SNAPLINK_LOG_PSEUDONYM_KEY=
# AERO_SNAPLINK_BILLING_RESOURCE=billing-api
# AERO_SNAPLINK_AUDIT_RESOURCE=audit-governance
# AERO_SNAPLINK_SOURCE_PREFIX=aero-im
# HTTP is accepted only for loopback development and only with this opt-in.
# AERO_SNAPLINK_ALLOW_INSECURE_LOOPBACK=false
AERO_SNAPLINK_REQUEST_TIMEOUT_SECS=10
AERO_SNAPLINK_PROJECTION_INTERVAL_SECS=60
AERO_SNAPLINK_DELIVERY_POLL_MS=250
# Must exceed two request timeouts plus two seconds (cold token + delivery).
AERO_SNAPLINK_DELIVERY_LEASE_SECS=30
AERO_SNAPLINK_DELIVERY_BATCH=100
AERO_SNAPLINK_DELIVERY_CONCURRENCY=16
AERO_SNAPLINK_SHUTDOWN_DRAIN_SECS=5
# AERO_TASK_DRAIN_SECS must exceed two request timeouts, this drain, and 2s.

# ---- Audit relay (aero-audit-connector, B5-2 + B5-4; optional) ----
# Presence-gated: ANY AERO_AUDIT_* variable set while AERO_AUDIT_TOKEN_ENDPOINT
# is missing is a boot error (fail-loud). Settles are gated by a durable
# heartbeat-freshness check (B5-4): row absent/stale => acknowledgements
# rejected fail-closed until the row is fresh again (60s server tick + boot
# bootstrap keep it fresh). A client-credentials token whose claims lack
# `audit:event:write` is deaded immediately (Forbidden-class T-11) with
# `last_error` = "audit:event:write scope missing from the client credentials
# token (T-11)" (scope auto-feedback; resurrection SQL in the runbook).
# AERO_AUDIT_TOKEN_ENDPOINT=https://sso.example.com/token
# AERO_AUDIT_CLIENT_ID=
# AERO_AUDIT_CLIENT_SECRET=
# AERO_AUDIT_AUDIENCE=audit-governance
# AERO_AUDIT_ISSUER=https://sso.example.com
# AERO_AUDIT_EXPECTED_SUB=aero-im.source
# AERO_AUDIT_SOURCE_SYSTEM=aero-im.source
# AERO_AUDIT_JWKS_URI=https://sso.example.com/.well-known/jwks.json
# Settle-face freshness window (default 300, bounds [60, 86400]; OOB bails boot).
# AERO_AUDIT_PROVISION_FRESHNESS_SECS=300
# Tier-2 outbox sampler cadence: 0 disables; garbage/negative/overflow disable
# fail-closed with a boot error; absent defaults to 300s.
# AERO__SERVER__AUDIT_OUTBOX_FULL_SAMPLE_SECS=300
# Bearer token for /metrics (default: unauthenticated — set one in production).
# AERO_METRICS_TOKEN=

# Sender message-idempotency tombstones. 0 disables cleanup; maximum is 3650.
AERO__SERVER__MESSAGE_SEND_KEY_RETENTION_DAYS=30
# Durable message-event relay cadence (0 disables) and published-row audit retention.
AERO__SERVER__EVENT_OUTBOX_POLL_MS=250
AERO__SERVER__EVENT_OUTBOX_RETENTION_DAYS=30
# Durable notification/index/moderation work created in the message transaction.
# 0 disables the relay on this instance; completed rows keep the configured days.
AERO__SERVER__MESSAGE_SIDE_EFFECT_POLL_MS=250
AERO__SERVER__MESSAGE_SIDE_EFFECT_RETENTION_DAYS=30
# Completed durable-consumer receipts. Pending producer outbox rows always keep
# their matching receipts regardless of this age; 0 disables cleanup.
AERO__SERVER__CONSUMER_RECEIPT_RETENTION_DAYS=30
# Used/expired password-reset rows are audit history only. Unused, unexpired
# reset tokens are never age-swept; 0 disables cleanup.
AERO__SERVER__PASSWORD_RESET_RETENTION_DAYS=7
# Durable bot-subscription delivery retention. Retryable pending/failed rows
# are never age-swept; dead rows and per-attempt history share the DLQ window.
AERO_BOT_DELIVERY_RETENTION_DAYS=30
AERO_BOT_DELIVERY_DLQ_RETENTION_DAYS=90
AERO_BOT_DELIVERY_SWEEP_SECS=3600
# Optional reply-notification aggregation. Presence of the first flag enables it.
# AERO_NOTIFICATION_BUNDLES=1
AERO_NOTIFICATION_BUNDLE_FLUSH_SECS=10
AERO__SERVER__NOTIFICATION_BUNDLE_RETENTION_DAYS=1
# Bounded outgoing webhook concurrency (values are clamped by the server).
AERO_WEBHOOK_GLOBAL_CONCURRENCY=32
AERO_WEBHOOK_ENDPOINT_CONCURRENCY=4
# PostgreSQL pg_stat_* health sampler cadence; 0 disables the sampler.
AERO_PG_STATS_SAMPLE_SECS=60
# Rolling shutdown: first fail readiness for this drain window, then cancel
# background/media work and wait up to TASK_DRAIN for cooperative completion.
AERO_SHUTDOWN_DRAIN_SECS=5
AERO_TASK_DRAIN_SECS=30
# Forwarding headers are ignored unless the immediate peer is in this
# comma-separated CIDR list. Leave empty for direct/local deployments.
# AERO_TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8:1234::/48
# Unique and restart-stable per Aero IM process. Each instance owns a distinct
# JetStream realtime cursor so local WebSocket clients receive every room event.
# AERO_INSTANCE_ID=im-node-01

# Message recall (撤回) window: how long after send the author may recall a
# message. 0 = unlimited; unset/invalid falls back to 86400 (24h). Room
# owner/admin recall (moderation path) is never subject to the window.
AERO_RECALL_WINDOW_SECS=86400

# ---- Live ingest ----
# RTMP and SRT listen independently from HTTP. POST /api/streams advertises
# these media ports, never AERO__SERVER__PORT.
AERO__SERVER__RTMP_LISTEN=0.0.0.0:1935
# SRT defaults to RTMP+1; this override is the actual public SRT listen address
# (boot translates it to the shared config convention).
AERO__LIVE__SRT_LISTEN=0.0.0.0:1936
# Numeric host advertised in WHIP/WHEP ICE and, when set, for wildcard RTMP/SRT
# listeners. Without it, media URLs use the AERO_PUBLIC_BASE_URL host.
AERO_INGEST_HOST=127.0.0.1
# Optional SRT AES-128-CTR passphrase (libsrt/FFmpeg length: 10..64 bytes) and
# per-session send pacing ceiling. When set, clear publishers are rejected.
# AERO_SRT_PASSPHRASE=
AERO_SRT_MAX_BANDWIDTH_BYTES_PER_SEC=1500000

# ---- Group-call SFU / cross-node call bridge ----
# `/api/rtc/config` publishes these values to the browser. Set `relay` only
# when a credentialed TURN server is configured and reachable by clients.
AERO_STUN_URLS=stun:stun.l.google.com:19302
# AERO_TURN_URL=turn:turn.example.com:3478
# AERO_TURN_USERNAME=
# AERO_TURN_PASSWORD=
AERO_ICE_TRANSPORT_POLICY=all
# Local defaults. In a multi-node deployment, advertise routable addresses;
# do not publish loopback/0.0.0.0 to browsers or peer nodes.
AERO_SFU_BIND_ADDR=0.0.0.0:0
AERO_SFU_ADVERTISE_HOST=127.0.0.1
AERO_BRIDGE_ADVERTISE_HOST=127.0.0.1
# Required to enable internal subscribe/RTCP-feedback endpoints across nodes.
# Use the same high-entropy value on every node.
# AERO_INTERNAL_BRIDGE_SECRET=
# Call-route Redis upgrade is two-phase. Keep false/unset while any pre-V2
# server remains (R1 dual-write/read); set true on every node only after the
# whole fleet runs R1 (R2 stops legacy writes and removes legacy call hashes).
AERO_CALL_ROUTE_V2_ONLY=false

# ---- Telemetry (OTLP → Jaeger) ----
AERO__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
AERO__TELEMETRY__LOG_LEVEL=info,aero=debug

# ---- MinIO (S3-compatible, used by aero-storage blobs) ----
# LocalFs remains the default. Uncomment only after the bucket exists; when
# explicitly selected, incomplete S3 configuration aborts startup.
# AERO_BLOB_BACKEND=s3
AERO_S3_ENDPOINT=http://localhost:9000
AERO_S3_REGION=us-east-1
AERO_S3_ACCESS_KEY=aero_minio
AERO_S3_SECRET_KEY=aero_minio_pw
AERO_S3_BUCKET=aero-blobs
# Optional production at-rest encryption for uploads. Accepts an AWS KMS key
# id, key ARN, alias name, or alias ARN; blank/unsafe values abort startup.
# AERO_S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/replace-me

# ---- Aero Vault attachment backend (alternative to LocalFs/S3) ----
# Browser/user tokens are never forwarded. In production Aero IM obtains a
# short-lived service token from Snaplink with client_credentials.
# AERO_BLOB_BACKEND=vault
# AERO_VAULT_URL=http://127.0.0.1:18081
# AERO_VAULT_TENANT=aero-im
# AERO_VAULT_PREFIX=im-attachments
# AERO_VAULT_OAUTH_TOKEN_ENDPOINT=https://sso.example.com/token
# AERO_VAULT_OAUTH_CLIENT_ID=aero-im-vault
# AERO_VAULT_OAUTH_CLIENT_SECRET=
# AERO_VAULT_OAUTH_SCOPE=read write
# AERO_VAULT_OAUTH_RESOURCE=aero-vault
# Static recovery/development alternative; do not set together with OAuth.
# AERO_VAULT_BEARER_TOKEN=

# Additional residency backends are a keyed map and are best configured with
# `[storage_regions.<code>]` blocks in config.toml; see config.example.toml.
# The reserved `default` code always refers to the primary store above.

# ---- Rust logging fallback ----
RUST_LOG=info,aero=debug
RUST_BACKTRACE=1

# ---- Transactional email (SMTP) ----
# Uncomment and fill in to enable password-reset / invitation emails.
# AERO__EMAIL__HOST=smtp.example.com
# AERO__EMAIL__PORT=587
# AERO__EMAIL__USERNAME=avc@example.com
# AERO__EMAIL__PASSWORD=smtp-password
# AERO__EMAIL__FROM=noreply@example.com
# AERO__EMAIL__STARTTLS=true
# Local capture servers only: forces plaintext and is rejected for non-loopback hosts.
# AERO__EMAIL__ALLOW_INSECURE_LOCALHOST=false

# ---- GIPHY slash-command integration (optional) ----
# Create a server-side API key in the GIPHY developer dashboard. The key is
# never sent to the browser or stored in message cards. Without it, `/giphy`
# reports itself unavailable instead of posting a placeholder.
# AERO_GIPHY_API_KEY=
# Supported maximum ratings are g, pg (default), and pg-13. Invalid/more
# permissive values fail toward pg.
AERO_GIPHY_RATING=pg
# Per-participant provider quota: Redis enforces the minute ceiling across the
# cluster, while each node enforces the short burst. The command also consumes
# the workspace send budget and atomically reserves room slow-mode before egress.
AERO_GIPHY_RATE_PER_MIN=10
AERO_GIPHY_RATE_BURST=3

# ---- Content-Security-Policy (optional) ----
# When set, every HTTP response carries a Content-Security-Policy header.
# Example for the bundled web app (hls.js + optional GIPHY cards):
# AERO_CSP_POLICY=default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://giphy.com https://*.giphy.com; connect-src 'self' ws: wss:
