# Aero IM — example environment variables.
# Copy to `.env` for local development. Values mirror docker-compose.yml defaults.
# Every AERO__* var maps onto AppConfig in crates/aero-common/src/config.rs.

# ---- Server ----
AERO__SERVER__HOST=0.0.0.0
AERO__SERVER__PORT=8080
AERO__SERVER__WEB_DIR=./web

# ---- Database (Postgres + pgvector) ----
AERO__DATABASE__URL=postgres://aero:aero_dev_pw@localhost:5432/aero
AERO__DATABASE__MAX_CONNECTIONS=16
# sqlx-cli also reads this:
DATABASE_URL=postgres://aero:aero_dev_pw@localhost:5432/aero

# ---- Redis ----
AERO__REDIS__URL=redis://localhost:6379

# ---- NATS JetStream ----
AERO__NATS__URL=nats://localhost:4222

# ---- Auth (JWT RS256) ----
# Generate keys: ./scripts/gen-jwt-keys.sh
# Prefer file-path indirection in production; for local dev, paste the PEM here
# or rely on config.toml. Multi-line env values must be quoted with literal \n.
AERO__AUTH__JWT_PRIVATE_KEY_PEM=
AERO__AUTH__JWT_PUBLIC_KEY_PEM=
AERO__AUTH__ISSUER=aero-im
AERO__AUTH__ACCESS_TTL_SECS=3600
AERO__AUTH__REFRESH_TTL_SECS=604800

# ---- Telemetry (OTLP → Jaeger) ----
AERO__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
AERO__TELEMETRY__LOG_LEVEL=info,aero=debug

# ---- MinIO (S3-compatible, used by aero-storage blobs) ----
AERO_S3_ENDPOINT=http://localhost:9000
AERO_S3_ACCESS_KEY=aero_minio
AERO_S3_SECRET_KEY=aero_minio_pw
AERO_S3_BUCKET=aero-blobs

# ---- Rust logging fallback ----
RUST_LOG=info,aero=debug
RUST_BACKTRACE=1
